#!/bin/sh
set -eu

MACOS_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
CONTENTS_DIR=$(dirname -- "$MACOS_DIR")
ROOT_FILE="$CONTENTS_DIR/Resources/bft-root.txt"

if [ -f "$ROOT_FILE" ]; then
    BFT_ROOT=$(sed -n '1p' "$ROOT_FILE")
else
    BFT_ROOT=$(CDPATH= cd -- "$MACOS_DIR/../../../../.." && pwd)
fi

RUNTIME_DIR=".bft-uninstalled"
if [ -f "$BFT_ROOT/.bft-runtime.txt" ]; then RUNTIME_DIR=$(sed -n '1p' "$BFT_ROOT/.bft-runtime.txt"); fi
PYTHON=""
for candidate in \
    "$BFT_ROOT/$RUNTIME_DIR/bin/python" \
    "$BFT_ROOT/.venv313/bin/python3" \
    "$BFT_ROOT/.venv313/bin/python" \
    "$BFT_ROOT/.venv312/bin/python3" \
    "$BFT_ROOT/.venv311/bin/python3"
do
    if [ -x "$candidate" ]; then PYTHON="$candidate"; break; fi
done
if [ -z "$PYTHON" ]; then PYTHON=$(command -v python3 || true); fi
if [ -z "$PYTHON" ]; then
    osascript -e 'display dialog "No supported Python 3 runtime was found for Bundle File Tool Web." with title "Bundle File Tool Web" buttons {"OK"}'
    exit 1
fi

# A Finder or Dock launch inherits launchd's minimal PATH, which hides
# pip-installed console scripts such as PyProjectMgr's `pyprojmgr`. Restoring
# the usual user locations makes a double-clicked app behave like a Terminal
# launch, for this process and for anything it starts.
PATH="$BFT_ROOT/$RUNTIME_DIR/bin:/opt/homebrew/bin:/usr/local/bin:${HOME:-}/.local/bin:${PATH:-/usr/bin:/bin:/usr/sbin:/sbin}"
export PATH

export PYTHONPATH="$BFT_ROOT/src"
cd "$BFT_ROOT"
exec "$PYTHON" "$BFT_ROOT/src/web_main.py"
